{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Android) Debug",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "preLaunchTask": "ADB: Silence MESA log",
      "env": {
        "JAVA_HOME": "${workspaceFolder}/.tmp/toolchains/jdk",
        "ANDROID_HOME": "${workspaceFolder}/.tmp/toolchains/android-sdk",
        "ANDROID_SDK_ROOT": "${workspaceFolder}/.tmp/toolchains/android-sdk"
      }
    },
    {
      "name": "Flutter (Windows) Debug",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "deviceId": "windows",
      "preLaunchTask": "Windows: Ensure Build Tools"
    },
    {
      "name": "Flutter (iOS) Debug",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "deviceId": "ios",
      "preLaunchTask": "iOS: Prepare Environment"
    }
  ]
}
