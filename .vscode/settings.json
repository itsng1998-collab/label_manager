{
	"editor.tabSize": 2,
	"dart.lineLength": 130,
	"editor.formatOnType": false,
	"editor.formatOnPaste": false,
	"editor.formatOnSave": false,
	"[dart]": {
		"editor.formatOnType": false,
    	"editor.rulers": [130],
	},
	"[plaintext]": {
  	"editor.wordWrap": "on"
	},
	"workbench.commandPalette.showAskInChat": false,
	"cmake.sourceDirectory": "${workspaceFolder}/windows",
	"cmake.autoDetectSourceDirectory": false,
	"dart.getFlutterSdkCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/prepare_build.ps1\" -Target Sdk -SdkPathOnly",
}
